{
  "name": "convex-wearables-workspace",
  "private": true,
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace @clipin/convex-wearables-web",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "pack:check": "npm pack --dry-run --workspace @clipin/convex-wearables",
    "release": "npm run release --workspace @clipin/convex-wearables --",
    "test": "turbo run test",
    "test:coverage": "npm run test:coverage --workspace @clipin/convex-wearables",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.10.8"
  }
}
